# Copy to .env. The backend refuses to start until POSTGRES_PASSWORD and SECRET_KEY are replaced; generate
# both with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Every setting is described in CONTRIBUTING.md → Settings.

POSTGRES_DB=birdography
POSTGRES_USER=birdography
POSTGRES_PASSWORD=change-me
# Where the backend finds the database when it runs outside Docker; in Docker it always uses db:5432.
# The development override (compose.override.yml) publishes the database on localhost at POSTGRES_PORT.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Photo storage; in Docker this host directory is mounted into the backend and handed to PUID:PGID at start.
UPLOAD_DIR=./data/photos
SECRET_KEY=change-me-to-a-long-random-string

# Optional

# Network (Docker): the web UI listens on BIND_ADDRESS:HTTP_PORT. 0.0.0.0 makes it reachable from other devices
# on the network; 127.0.0.1 keeps it to this machine.
# BIND_ADDRESS=0.0.0.0
# HTTP_PORT=3000
# API_PORT=8000            # development override only: the API on localhost
# User and group the backend runs as and the photo files belong to (set to your `id -u` / `id -g`).
# PUID=1000
# PGID=1000
# Behind another reverse proxy: its address(es), so the real client address reaches the login throttle.
# TRUSTED_PROXIES=172.17.0.1
# Serving over HTTPS (through a reverse proxy): send the session cookie only over HTTPS.
# SECURE_COOKIES=false

# Accounts
# SESSION_DAYS=30         # idle limit; browser sessions renew while in use
# SESSION_MAX_DAYS=90     # hard cap, counted from the login
# ALLOW_REGISTRATION=false

# Uploads: limits in MB (standard images / RAW), and the size above which previews are generated after the response
# MAX_UPLOAD_MB=40
# MAX_RAW_UPLOAD_MB=70
# BACKGROUND_DERIVATIVES_MB=20
# CLIENT_MAX_BODY_SIZE=75m   # nginx request limit; keep it above MAX_RAW_UPLOAD_MB
# EXIFTOOL_PATH=exiftool

# TRASH_DAYS=30
