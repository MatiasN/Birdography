server {
    listen 8080;
    root /usr/share/nginx/html;
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};
    # The map loads every photo position at once (/api/photos/points); JSON compresses about 4:1.
    gzip on;
    gzip_types application/json;
    gzip_min_length 1024;

    location /api/ {
        proxy_pass http://backend:8000/;
        proxy_set_header Host $host;
        # Replaced, not appended to: the backend trusts this header for the login throttle, so clients must not be
        # able to set it. Behind another proxy, TRUSTED_PROXIES makes $remote_addr the real client (real-ip.sh).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri /index.html;
    }
}
